# -----------------------------------------------------------------------------
# LaFineEquipe — modèle de configuration (AUCUN secret ici).
# Copie ce fichier en `.env.local` puis remplis les valeurs sur ton PC.
# `.env.local` est ignoré par git : ne le partage jamais, ne le colle jamais dans un chat.
# -----------------------------------------------------------------------------

# Source des données :
#   local    = base PostgreSQL embarquée (PGlite) dans le dossier .data/, pour développer sur ton PC.
#              Interdit en production (le site refuse de démarrer avec LFE_HOSTED=1 sur le serveur).
#   supabase = ton projet Supabase (obligatoire en ligne).
LFE_DATA_BACKEND=local

# --- Supabase (Project Settings > API Keys) ---------------------------------
# URL du projet, ex. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clé « publishable » (sb_publishable_…) ou ancienne clé « anon ». Publique par nature.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé « secret » (sb_secret_…) ou ancienne clé « service_role ». SERVEUR UNIQUEMENT.
# Utilisée seulement par la synchronisation FACEIT planifiée.
SUPABASE_SECRET_KEY=
# E-mail du compte Supabase unique d'administration. On se connecte sur /connexion avec
# l'identifiant « admin » : le serveur le traduit en cet e-mail (jamais envoyé au navigateur).
# Le mot de passe est choisi par toi dans Supabase, il n'est écrit nulle part ici.
LFE_ADMIN_EMAIL=

# --- FACEIT Data API v4 (developers.faceit.com > App Studio > API Keys) ------
# Clé de type « Server side ». SERVEUR UNIQUEMENT, jamais préfixée NEXT_PUBLIC_.
FACEIT_API_KEY=
# live     = vraie API FACEIT (défaut)
# fixtures = profils fictifs de test, sans réseau (dev/tests uniquement, refusé en production)
FACEIT_MODE=live

# --- Synchronisation planifiée -----------------------------------------------
# Long texte aléatoire partagé avec le planificateur (Supabase Cron).
# Génère-le avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Adresse publique du site (liens canoniques, partage, sitemap).
# En ligne : origine HTTPS uniquement, sans chemin, paramètres ni identifiants.
# En ligne : https://fineequipe.com
# Local, données de démo et aperçus restent non indexables.
SITE_URL=http://localhost:3000

# --- Serveur de production (VPS) ---------------------------------------------
# Mets 1 sur le serveur en ligne : interdit le mode « local » et les profils fictifs.
# Laisse vide sur ton PC.
LFE_HOSTED=
